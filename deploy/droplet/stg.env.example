# Copy to ~/.config/apto/stg.env on the droplet user (chmod 600).
# CI: SQL Server from secret APTO_STG_CONNECTION_STRING, or SQLite demo via write-stg-sqlite-env.sh.
ConnectionStrings__Default=Server=YOUR_HOST,1433;Database=Apto;User Id=...;Password=...;TrustServerCertificate=True
# ConnectionStrings__Default=Data Source=$HOME/opt/apto-data/apto.db
